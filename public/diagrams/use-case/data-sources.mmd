%% Each color is one data source. The icons are the same as in data-movement.mmd.

flowchart TD
    classDef chain fill:#fff1dd,stroke:#f7931a,stroke-width:2px,color:#4a2a00
    classDef agg fill:#efe7fb,stroke:#7e57c2,stroke-width:2px,color:#2e1a4f
    classDef sidecar fill:#e3f4e6,stroke:#2e7d32,stroke-width:2px,color:#123d17
    classDef cas fill:#e2eefb,stroke:#1565c0,stroke-width:2px,color:#0b2d55
    classDef actor fill:#f4f4f4,stroke:#555555,color:#111111

    Agg["🤝 Aggregation Service<br/>cohort only<br/><br/>📝 Unsigned Beacon Signals<br/>🗺 CAS Announcements<br/>🌲 SMT Proofs"]:::agg
    Stu(["Stuart"]):::actor
    Sidecar["🧳 Sidecar Data<br/>private<br/><br/>🧾 updates<br/>🗺 CAS Announcements<br/>🌲 SMT Proofs"]:::sidecar
    CAS["📦 CAS / IPFS<br/>public<br/><br/>🧾 updates<br/>🗺 CAS Announcements"]:::cas
    Chain["⛓ Bitcoin<br/>public<br/><br/>⛓ Beacon Signals"]:::chain
    Res(["Satoshi's resolver"]):::actor

    Agg --> Stu
    Stu --> Sidecar
    Stu -.-> CAS
    Sidecar --> Res
    CAS -.-> Res
    Chain --> Res

    linkStyle 0 stroke:#7e57c2,stroke-width:2px
    linkStyle 1,3 stroke:#2e7d32,stroke-width:2px
    linkStyle 2,4 stroke:#1565c0,stroke-width:2px
    linkStyle 5 stroke:#f7931a,stroke-width:2px
